# cTrader Open API credentials (DEMO account only). Copy to .env and fill in. Never commit .env.
CTRADER_CLIENT_ID=your-client-id
CTRADER_CLIENT_SECRET=your-client-secret
CTRADER_ACCESS_TOKEN=your-access-token
# Used by program/engine.py and program/risk.py
CTRADER_DEMO_ACCOUNT_ID=0000000
CTRADER_LIVE_ACCOUNT_IDS=
# Optional: X (Twitter) API v2 bearer token for program/xsent.py
X_BEARER_TOKEN=
